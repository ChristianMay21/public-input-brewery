{
  "name": "boilerplate",
  "version": "1.0.0",
  "description": "Personal project template for my web applications",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "create-component": "tsx .claude/skills/react-component/create-component.ts"
  },
  "dependencies": {
    "@untitled-ui/icons-react": "^0.1.4",
    "cross-env": "^7.0.3",
    "next": "16.3.4",
    "radix-ui": "^1.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.1.5",
    "prettier": "^3.4.2",
    "sass": "^1.103.1",
    "tsx": "^4.23.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
